# Domän som Caddy skaffar HTTPS-certifikat för (docker compose). DNS måste peka på servern.
DOMAIN=floorballflash.example.se
# Publik adress till sidan – används i länkar i e-post (godkänn/neka, lösenordslänk)
PUBLIC_URL=https://floorballflash.example.se
PORT=3000

# Administratör: får godkännandemejl och loggar in på /admin.html
ADMIN_EMAIL=andreas.wallin@gmail.com

# Laget som visas (från stats.innebandy.se/sasong/44/lag/120879/spelprogram)
TEAM_ID=120879
SEASON_ID=44
# Serier (serie-ID från stats.innebandy.se) som alltid tas med, kommaseparerade.
# Fler kan läggas till på adminsidan.
COMPETITION_IDS=45219
# Enstaka matcher (match-ID) som alltid tas med, t.ex. cup- eller träningsmatcher.
EXTRA_MATCH_IDS=

# SMTP för att skicka e-post. Utan SMTP_HOST loggas mejlen bara (syns på adminsidan).
# Gmail: SMTP_PASS ska vara ett applösenord (kräver tvåstegsverifiering).
# Skriv värdena utan citattecken.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Floorballflash <noreply@example.se>

# Hur länge länken i godkännandemejlet gäller (dagar). Efter det godkänns användaren på adminsidan.
APPROVAL_LINK_DAYS=90
# Hur länge efter en match det går att ladda upp klipp (timmar). Admin kan alltid ladda upp.
UPLOAD_WINDOW_HOURS=12

# Var databas och uppladdade filmer sparas
DATA_DIR=./data
# Maxstorlek per filmklipp
MAX_UPLOAD_MB=1024

# Hur ofta pågående matcher hämtas (sekunder)
LIVE_POLL_SECONDS=20
# Sätt till 1 för demodata utan internetåtkomst
IBIS_MOCK=0
# Bakom en reverse proxy: antal proxy-hopp eller "loopback" (docker compose sätter 1 själv)
TRUST_PROXY=loopback
